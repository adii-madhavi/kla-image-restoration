__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/
.venv/
.clean_env_test_venv/
*.egg-info/

# large artifacts that should not be committed wholesale
# NOTE: anchored to repo root (leading /) - an unanchored `data/` also
# matches src/data/, which is source code, not a data artifact.
/data/
/data_raw/
# keep out stray/intermediate checkpoints, but weights/final.pt IS the
# required submission artifact (weights/README.md) and must be tracked.
weights/*.pt
weights/*.pth
weights/*.onnx
!weights/final.pt
results/
*.zip

# OS
.DS_Store
